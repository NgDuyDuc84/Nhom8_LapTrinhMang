{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Build toan bo solution LanMonitor (Debug)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/LanMonitor.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "detail": "Xoa thu muc bin/obj",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/src/LanMonitor.sln"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
